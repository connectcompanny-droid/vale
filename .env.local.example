# Vale on your own computer (no Docker): SQLite file + in-process queue. Copy to .env and fill.
DATABASE_URL=sqlite+aiosqlite:///./vale.db
QUEUE_MODE=inline
AUTO_CREATE_TABLES=true
LLM_CONCURRENCY=4
MONITOR_MAX_CONCURRENCY=1

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ANTHROPIC_API_KEY=

UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
# python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Groq (free tier): https://api.groq.com/openai/v1/audio/transcriptions + whisper-large-v3
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-large-v3
TTS_PROVIDER=none

HEADLESS=true
BROWSER_CHANNEL=auto

# --- Billing (Stripe). Leave STRIPE_SECRET_KEY empty for the free beta (no payment step). ---
# Stripe dashboard > Developers > API keys (use sk_test_... until launch).
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > endpoint https://SEU-ENDERECO/webhook/stripe,
# event checkout.session.completed > "Signing secret" (whsec_...).
STRIPE_WEBHOOK_SECRET=
ACTIVATION_FEE_CENTS=990
SUCCESS_FEE_CENTS=2900
FOUNDER_SLOTS=50
FOUNDER_DISCOUNT_PCT=50

# Public address of the API (payment return pages): https://... without a trailing slash.
PUBLIC_BASE_URL=
# Links shown in the consent message.
TERMS_URL=
PRIVACY_URL=
# Operator view: https://SEU-ENDERECO/admin/summary?token=ADMIN_TOKEN (python -c "import secrets; print(secrets.token_hex(24))")
ADMIN_TOKEN=
# Day-before reminder is sent from this hour (Madrid time).
REMINDER_HOUR=10

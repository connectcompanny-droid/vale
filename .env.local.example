# Vale on your own computer (no Docker): SQLite file + in-process queue. Copy to .env and fill.
DATABASE_URL=sqlite+aiosqlite:///./vale.db
QUEUE_MODE=inline
AUTO_CREATE_TABLES=true
LLM_CONCURRENCY=4
MONITOR_MAX_CONCURRENCY=1

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ANTHROPIC_API_KEY=

UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
# python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Groq (free tier): https://api.groq.com/openai/v1/audio/transcriptions + whisper-large-v3
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-large-v3
TTS_PROVIDER=none

HEADLESS=true
BROWSER_CHANNEL=auto

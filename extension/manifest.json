{
  "manifest_version": 3,
  "name": "Vale Copiloto",
  "version": "1.0.0",
  "description": "Copiloto del operador de Vale: rellena los datos del cliente en la web de cita previa cuando el operador lo pide, y avisa al cliente.",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Vale Copiloto" },
  "content_scripts": [
    {
      "matches": ["https://icp.administracionelectronica.gob.es/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}

# --- Banco de dados (Supabase/Postgres em produção, SQLite para testes locais) ---
DATABASE_URL=postgresql+asyncpg://vale:vale@db:5432/vale

# --- Criptografia dos dados dos documentos ---
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- WhatsApp via UAZAPI ---
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_INSTANCE_TOKEN=
# Segredo que a UAZAPI envia na URL do webhook: https://seu-dominio/webhook/uazapi?secret=...
WEBHOOK_SECRET=

# --- Áudio (transcrição de notas de voz) ---
# Qualquer endpoint compatível com OpenAI. Ex.: Groq (mais barato): https://api.groq.com/openai/v1/audio/transcriptions + whisper-large-v3
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1

# --- Respostas em áudio (opcional) ---
# none = só texto. elevenlabs ou openai = o Vale também responde com nota de voz.
TTS_PROVIDER=none
TTS_API_KEY=
TTS_MODEL=
# ID da voz por idioma (na ElevenLabs, o voice_id de cada voz).
TTS_VOICE_PT=
TTS_VOICE_ES=
TTS_VOICE_EN=
TTS_MAX_CHARS=600

# --- Monitor de citas ---
# Intervalo mínimo entre verificações de um mesmo pedido (minutos) e verificações simultâneas no total.
MONITOR_MIN_INTERVAL_MINUTES=10
MONITOR_MAX_CONCURRENCY=2
# Quanto tempo uma vaga oferecida espera a confirmação do usuário (minutos).
OFFER_TTL_MINUTES=10
HEADLESS=true
# chrome = Google Chrome real (recomendado). Vazio = Chromium embutido do Playwright.
BROWSER_CHANNEL=chrome
# Pausa das verificações após erro de certificado (minutos). Nunca desative a verificação TLS.
TLS_PAUSE_MINUTES=30
# Pausa quando o firewall do site bloqueia o acesso (minutos). Nunca tente contornar o bloqueio.
BLOCKED_PAUSE_MINUTES=360
